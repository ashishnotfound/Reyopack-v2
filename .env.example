# Supabase project values from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Server/CLI only. Percent-encode reserved password characters.
SUPABASE_DB_URL=postgresql://postgres:replace_me@db.your-project.supabase.co:5432/postgres?sslmode=verify-full

# App URL used for password reset and auth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Protects the scheduled marketplace-sync endpoint
CRON_SECRET=replace-with-a-long-random-value

# Optional server-only fallback. Prefer the Super Admin > Integrations panel,
# which stores these values in Supabase Vault and applies changes immediately.
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=
AMAZON_SP_API_MARKETPLACE_IDS=A21TJRUUN4KGV
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com

# Explicit local/test-only adapter. Never enable in production.
REYO_PACK_DEMO_MODE=false
